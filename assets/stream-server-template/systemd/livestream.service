[Unit]
Description=VPS Livestream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stream-server
ExecStart=/opt/stream-server/scripts/start.sh
ExecStop=/opt/stream-server/scripts/stop.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
